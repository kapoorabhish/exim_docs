# Database
DATABASE_URL="postgresql://exim:exim_dev_password@localhost:5432/exim_dev"

# Redis
REDIS_URL="redis://localhost:6379"

# JWT
JWT_SECRET="change-this-to-a-random-secret-in-production"
JWT_ACCESS_EXPIRY="15m"
JWT_REFRESH_EXPIRY="7d"

# App
APP_URL="http://localhost:3000"
API_PORT=3001

# SMTP — local dev: Mailpit (docker compose up mailpit → UI at http://localhost:8025)
# Production: use a real SMTP provider (SES, SendGrid, Postmark, etc.)
SMTP_HOST="localhost"
SMTP_PORT=1025
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="noreply@exim.app"
